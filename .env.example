# Website AI is optional. A fresh clone runs the canvas without credentials.
# Server-side only. Never prefix these variables with VITE_.
AI_ROUTING_MODE=disabled
# Set direct or gateway deliberately before enabling inference.
# AI_ENABLED=false is an independent emergency kill switch in both modes.
# AI_REQUIRE_GATEWAY=true is required on the official hosted deployment.

# Your own Azure resource, key, and deployment. The deployment name is an alias;
# verify that its underlying model is gpt-6-luna, version 2026-09-22, for #17.
AZURE_RESOURCE_NAME=your-resource-name
AZURE_DEPLOYMENT_NAME=your-deployment-name
AZURE_API_KEY=
AZURE_API_VERSION=2024-10-21
AZURE_MAX_COMPLETION_TOKENS=4000
# Optional. Omit temperature; Luna works with this API and structured JSON.
# AZURE_REASONING_EFFORT=low

# Required in either enabled mode. Verify your provider's current USD prices.
# Luna short-context GlobalStandard reference prices on 2026-10-27 are
# 0.10 input / 0.50 output per million tokens. Do not assume another model,
# region, SKU, or provider contract has those prices.
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
# Reserves this multiple of the conservative byte-based token cost per attempt.
AI_ADMISSION_COST_MULTIPLIER=2

# Gateway mode only. All three values belong to the deployment operator.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=

# Limits apply in direct and gateway modes. AI controls fail closed independently
# of FLOW_RATE_LIMIT. Production defaults to Redis using either KV/UPSTASH pair.
# Vercel always requires Redis. Memory is for local or single-process hosting.
# AI_ADMISSION_STORE=redis
# AI_ENVIRONMENT=production
AI_CLIENT_REQUESTS_PER_MINUTE=6
AI_GLOBAL_REQUESTS_PER_MINUTE=30
AI_DAILY_BUDGET_USD=5
AI_MAX_CONCURRENT=3
AI_MAX_BODY_BYTES=131072
AI_MAX_INPUT_BYTES=163840
AI_MAX_RESPONSE_BYTES=262144
AI_TIMEOUT_MS=45000

# Shared charts and the MCP server (/api/flows, /api/mcp)
# Upstash Redis stores charts and rate limits. Connecting "Upstash for Redis"
# from the Vercel Marketplace sets the KV_* pair; the UPSTASH_* pair from the
# Upstash console works too. Required in production. Locally, charts fall back
# to a file in the system temp directory when these are empty.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: origin used in returned links (defaults to the request's host)
# PUBLIC_BASE_URL=https://flowchart.zeroclickdev.ai

# Optional: delete charts after this many days without changes (unset = keep)
# FLOW_TTL_DAYS=365

# Optional: "off" disables all rate limits and budgets
# FLOW_RATE_LIMIT=off

# Optional: rate limits ("<count>/<window>", window in s, m, h or d; or "off").
# Per IP address. Agents in the cloud share their provider's IPs, so the MCP
# tool limits are higher than the browser's REST limits.
# FLOW_LIMIT_MCP_CREATE=300/1h
# FLOW_LIMIT_MCP_WRITE=1200/1h
# FLOW_LIMIT_CREATE=30/10m
# FLOW_LIMIT_WRITE=120/1m
# Counted in memory per server instance (no Redis commands):
# FLOW_LIMIT_READ=600/1m
# FLOW_LIMIT_POLL=1200/1m
# FLOW_LIMIT_MCP=1200/1m
# Budgets shared by all users (daily ones reset at 00:00 UTC):
# FLOW_BUDGET_CREATES=5000/1d
# FLOW_BUDGET_WRITES=50000/1d
# FLOW_BUDGET_STORAGE=50mb/1d

# Optional: trust X-Forwarded-For / X-Real-IP behind your own proxy (always on for Vercel)
# FLOW_TRUST_PROXY=1
