# Azure OpenAI Configuration (Server-side only)
# These are used by the Vercel Serverless Function at /api/chat
# Copy this file to .env and fill in your values
# DO NOT use VITE_* prefix - these are server-side only

AZURE_DEPLOYMENT_NAME=your-deployment-name
AZURE_RESOURCE_NAME=your-resource-name
AZURE_API_KEY=your-api-key

# Shared charts and the MCP server (/api/flows, /api/mcp)
# Upstash Redis stores charts and rate limits. Connecting "Upstash for Redis"
# from the Vercel Marketplace sets the KV_* pair; the UPSTASH_* pair from the
# Upstash console works too. Required in production. Locally, charts fall back
# to a file in the system temp directory when these are empty.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Fixed website origin: required for production chat and Premium mutations.
# It also determines returned links. HTTPS is required outside localhost.
# PUBLIC_BASE_URL=https://flowchart.zeroclickdev.ai

# Optional: delete charts after this many days without changes (unset = keep)
# FLOW_TTL_DAYS=365

# Optional: "off" disables all rate limits and budgets
# FLOW_RATE_LIMIT=off

# Optional: rate limits ("<count>/<window>", window in s, m, h or d; or "off").
# Per IP address. Agents in the cloud share their provider's IPs, so the MCP
# tool limits are higher than the browser's REST limits.
# FLOW_LIMIT_MCP_CREATE=300/1h
# FLOW_LIMIT_MCP_WRITE=1200/1h
# FLOW_LIMIT_CREATE=30/10m
# FLOW_LIMIT_WRITE=120/1m
# Counted in memory per server instance (no Redis commands):
# FLOW_LIMIT_READ=600/1m
# FLOW_LIMIT_POLL=1200/1m
# FLOW_LIMIT_MCP=1200/1m
# Budgets shared by all users (daily ones reset at 00:00 UTC):
# FLOW_BUDGET_CREATES=5000/1d
# FLOW_BUDGET_WRITES=50000/1d
# FLOW_BUDGET_STORAGE=50mb/1d

# Optional: trust X-Forwarded-For / X-Real-IP behind your own proxy (always on for Vercel)
# FLOW_TRUST_PROXY=1

# Optional website text-AI capacity limits (defaults shown).
# Production requires the shared Redis pair above; outages fail closed.
# CHAT_LIMIT_PER_MINUTE=6
# CHAT_LIMIT_PER_HOUR=40
# CHAT_BUDGET_PER_DAY=300
# CHAT_IN_FLIGHT_PER_CLIENT=2
# CHAT_IN_FLIGHT_GLOBAL=10

# Optional Premium image studio. Keep all values server-side.
# Use an isolated Stripe sandbox during development. See docs/premium.md.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
# Generate at least 32 random characters; for example: openssl rand -hex 32
BILLING_SESSION_SECRET=
# Set BILLING_MODE=live only when deliberately enabling live payments.
# Local development file storage is automatic; production requires Redis.
# BILLING_STORE_FILE=/absolute/private/path/billing.local
OPENAI_IMAGE_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# PREMIUM_IMAGE_MONTHLY_LIMIT=30
# PREMIUM_IMAGE_DAILY_LIMIT=5
# IMAGE_GLOBAL_DAILY_LIMIT=100
# IMAGE_COOLDOWN_SECONDS=20

# ChatGPT plan usage is not enabled. Hosted commercial access requires
# OpenAI approval/provisioning; do not put consumer tokens in this file.
